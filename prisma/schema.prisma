// ==========================================
// PRISMA CONFIGURATION & DATASOURCE
// ==========================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS & DOMAIN TAXONOMIES
// ==========================================

enum ProjectStatus {
  COMPLETED_PROTOTYPE
  PARTIALLY_COMPLETED
  NOT_DEPLOYED
  CLIENT_PROJECT
  DEVELOPMENT_PROJECT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OperationalStatus {
  IN_DEVELOPMENT
  STAGING
  PROTOTYPE_COMPLETE
  NOT_IN_PRODUCTION
}

enum InquiryStatus {
  NEW
  READ
  ARCHIVED
  RESPONDED
}

enum TechCategory {
  LANGUAGES
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS_CLOUD
  MOBILE
  PAYMENTS_APIS
  SYSTEMS_QUANT
}

// ==========================================
// ENTITY DEFINITIONS
// ==========================================

/// Administrative Users for Portfolio Management
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  name         String    @db.VarChar(100)
  role         String    @default("ADMIN") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  lastLogin    DateTime? @db.Timestamptz

  @@map("admin_users")
}

/// Dynamic System Project Categories
model ProjectCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  
  projects    Project[]

  @@map("project_categories")
}

/// Independent Technology Master List
model Technology {
  id        String              @id @default(uuid()) @db.Uuid
  name      String              @unique @db.VarChar(100)
  slug      String              @unique @db.VarChar(120)
  category  TechCategory
  iconName  String?             @db.VarChar(100)
  isCore    Boolean             @default(false)
  createdAt DateTime            @default(now()) @db.Timestamptz
  updatedAt DateTime            @updatedAt @db.Timestamptz

  projects  ProjectTechnology[]

  @@index([category])
  @@map("technologies")
}

/// Main Project Entity (Unified)
model Project {
  id                   String            @id @default(uuid()) @db.Uuid
  title                String            @db.VarChar(200)
  slug                 String            @unique @db.VarChar(220)
  tagline              String?           @db.VarChar(255)
  summary              String            @db.VarChar(500)
  overview             String?           @db.Text
  objective            String?           @db.Text
  problem              String?           @db.Text
  solution             String?           @db.Text
  detailedContext      String            @db.Text
  systemType           String            @db.VarChar(150)
  
  // Status Taxonomy
  status               ProjectStatus
  publicationStatus    PublicationStatus @default(DRAFT)
  operationalStatus    OperationalStatus @default(IN_DEVELOPMENT)
  
  published            Boolean           @default(true)
  featured             Boolean           @default(false)
  displayOrder         Int               @default(0)
  
  // Project Metadata & External References
  githubUrl            String?           @db.VarChar(500)
  liveUrl              String?           @db.VarChar(500)
  demoUrl              String?           @db.VarChar(500)
  caseStudyRef         String?           @db.VarChar(255)
  duration             String?           @db.VarChar(100)
  
  // Honest Narrative Declarations
  commercialStatusNote String            @db.VarChar(500)
  technicalChallenges  String            @db.Text
  
  // Timestamps
  createdAt            DateTime          @default(now()) @db.Timestamptz
  updatedAt            DateTime          @updatedAt @db.Timestamptz

  // Foreign Keys & Relationships
  categoryId           String            @db.Uuid
  category             ProjectCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologies         ProjectTechnology[]
  features             ProjectFeature[]
  images               ProjectImage[]
  caseStudy            ProjectCaseStudy?

  @@index([slug])
  @@index([published, displayOrder])
  @@index([status])
  @@map("projects")
}

/// Many-to-Many Junction Table for Project and Technology
model ProjectTechnology {
  projectId    String     @db.Uuid
  technologyId String     @db.Uuid
  
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@map("project_technologies")
}

/// Key Features Associated with a Project
model ProjectFeature {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  title        String   @db.VarChar(200)
  description  String   @db.Text
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, displayOrder])
  @@map("project_features")
}

/// Visual Media Assets Linked to a Project
model ProjectImage {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  url          String   @db.VarChar(500)
  caption      String?  @db.VarChar(255)
  altText      String   @db.VarChar(255)
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, displayOrder])
  @@map("project_images")
}

/// In-Depth Architectural Case Study
model ProjectCaseStudy {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @unique @db.Uuid
  architectureDiagram  String?  @db.Text
  problemStatement     String   @db.Text
  systemArchitecture   String   @db.Text
  dataFlowDescription  String   @db.Text
  tradeOffs            String   @db.Text
  outcomesAndLearnings String   @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_case_studies")
}

/// Offered Professional Engineering Capabilities
model Service {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(170)
  summary      String   @db.VarChar(300)
  description  String   @db.Text
  icon         String   @db.VarChar(100)
  isCoreFocus  Boolean  @default(false)
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([published, displayOrder])
  @@map("services")
}

/// Ingested Client Inquiries
model ContactInquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(150)
  email     String        @db.VarChar(255)
  company   String?       @db.VarChar(150)
  subject   String        @db.VarChar(200)
  message   String        @db.Text
  ipAddress String?       @db.VarChar(45)
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  @@index([status])
  @@index([createdAt])
  @@map("contact_inquiries")
}

/// Global Portfolio Configuration Settings
model SiteConfiguration {
  id           String   @id @default("default") @db.VarChar(50)
  ownerName    String   @default("Nickson Muriithi") @db.VarChar(100)
  ownerTitle   String   @default("Software Developer | Systems & Full-Stack Development") @db.VarChar(150)
  corePosition String   @default("I build software systems that connect people, data, services, and business processes.") @db.Text
  availability String   @default("Available for Contracts & Engineering Roles") @db.VarChar(150)
  contactEmail String   @default("contact@riithis.dev") @db.VarChar(255)
  githubUrl    String?  @db.VarChar(255)
  linkedinUrl  String?  @db.VarChar(255)
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("site_configurations")
}